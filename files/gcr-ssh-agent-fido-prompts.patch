+typedef struct {
+	GMainLoop *loop;
+	const gchar *message;
+} NotifyContext;
+
+static void
+on_notify_confirm (GObject *source_object,
+                   GAsyncResult *result,
+                   gpointer user_data)
+{
+	NotifyContext *ctx = user_data;
+
+	gcr_prompt_confirm_finish (GCR_PROMPT (source_object), result, NULL);
+	g_main_loop_quit (ctx->loop);
+}
+
+static void
+on_notify_open (GObject *source_object,
+                GAsyncResult *result,
+                gpointer user_data)
+{
+	NotifyContext *ctx = user_data;
+	GcrPrompt *prompt;
+	GError *error = NULL;
+
+	prompt = gcr_system_prompt_open_finish (result, &error);
+	if (!prompt) {
+		g_debug ("couldn't open prompt for notification: %s", error->message);
+		g_error_free (error);
+		g_main_loop_quit (ctx->loop);
+		return;
+	}
+
+	/* The prompt stays referenced until the process exits */
+	gcr_prompt_set_title (prompt, _("Use your security key"));
+	gcr_prompt_set_message (prompt, _("Touch your security key to continue"));
+	gcr_prompt_set_description (prompt, ctx->message);
+	gcr_prompt_set_continue_label (prompt, _("Hide"));
+	gcr_prompt_confirm_async (prompt, NULL, on_notify_confirm, ctx);
+}
+
+/*
+ * SSH_ASKPASS_PROMPT=none: OpenSSH shows a message while it waits for a
+ * security key touch, and kills the askpass with SIGTERM once the key
+ * answers. There is nothing to send back, so this doesn't go through
+ * gcr-ssh-agent's socket (that would leave a password prompt behind when
+ * the process dies). The prompt is opened straight with the system
+ * prompter, which closes it by itself when this process leaves the bus.
+ * Best effort: if no prompter is reachable, just exit.
+ */
+static int
+show_notification (const gchar *message)
+{
+	NotifyContext ctx = { NULL, message };
+
+	ctx.loop = g_main_loop_new (NULL, FALSE);
+	gcr_system_prompt_open_async (-1, NULL, on_notify_open, &ctx);
+	g_main_loop_run (ctx.loop);
+	g_main_loop_unref (ctx.loop);
+
+	return 0;
+}
+
