+/* Records the message the askpass relayed, and answers with "yes" */
+typedef struct {
+	GTlsInteraction parent;
+	gchar *description;
+} RecordingInteraction;
+
+typedef struct {
+	GTlsInteractionClass parent;
+} RecordingInteractionClass;
+
+static GType recording_interaction_get_type (void);
+G_DEFINE_TYPE (RecordingInteraction, recording_interaction, G_TYPE_TLS_INTERACTION);
+
+static void
+recording_interaction_init (RecordingInteraction *self)
+{
+}
+
+static void
+recording_interaction_finalize (GObject *obj)
+{
+	g_free (((RecordingInteraction *)obj)->description);
+	G_OBJECT_CLASS (recording_interaction_parent_class)->finalize (obj);
+}
+
+static GTlsInteractionResult
+recording_interaction_ask_password (GTlsInteraction *interaction,
+                                    GTlsPassword *password,
+                                    GCancellable *cancellable,
+                                    GError **error)
+{
+	RecordingInteraction *self = (RecordingInteraction *)interaction;
+
+	g_free (self->description);
+	self->description = g_strdup (g_tls_password_get_description (password));
+	g_tls_password_set_value (password, (const guchar *)"yes", 3);
+	return G_TLS_INTERACTION_HANDLED;
+}
+
+static void
+recording_interaction_class_init (RecordingInteractionClass *klass)
+{
+	G_OBJECT_CLASS (klass)->finalize = recording_interaction_finalize;
+	G_TLS_INTERACTION_CLASS (klass)->ask_password = recording_interaction_ask_password;
+}
+
+/* The test log handler prints g_setenv()'s debug message to stdout,
+ * which here is the askpass output being checked */
+static void
+quiet_child_setup (gpointer askpass)
+{
+	int saved_stdout = dup (STDOUT_FILENO);
+	int devnull = open ("/dev/null", O_WRONLY);
+
+	dup2 (devnull, STDOUT_FILENO);
+	close (devnull);
+	gcr_ssh_askpass_child_setup (askpass);
+	dup2 (saved_stdout, STDOUT_FILENO);
+	close (saved_stdout);
+}
+
+static gchar *
+run_askpass (GcrSshAskpass *askpass,
+             const gchar *prompt_mode,
+             gchar **args,
+             gint *exit_status)
+{
+	GError *error = NULL;
+	GPtrArray *argv;
+	gchar buffer[64] = { 0, };
+	gssize count;
+	gint output;
+	gint status = -1;
+	GPid pid;
+
+	argv = g_ptr_array_new ();
+	g_ptr_array_add (argv, (gchar *)_GCR_TEST_SSH_ASKPASS_PATH);
+	for (; *args; args++)
+		g_ptr_array_add (argv, *args);
+	g_ptr_array_add (argv, NULL);
+
+	/* Set in this process rather than through envp, which would replace
+	 * what gcr_ssh_askpass_child_setup() adds in the child */
+	g_unsetenv ("GCR_SSH_ASKPASS_SOCKET");
+	/* No prompter is reachable: a notification must give up right away */
+	g_setenv ("DBUS_SESSION_BUS_ADDRESS", "unix:path=/nonexistent/bus", TRUE);
+	if (prompt_mode)
+		g_setenv ("SSH_ASKPASS_PROMPT", prompt_mode, TRUE);
+	else
+		g_unsetenv ("SSH_ASKPASS_PROMPT");
+
+	g_spawn_async_with_pipes (NULL, (gchar **)argv->pdata, NULL,
+	                          G_SPAWN_DO_NOT_REAP_CHILD,
+	                          askpass ? quiet_child_setup : NULL, askpass,
+	                          &pid, NULL, &output, NULL, &error);
+	g_unsetenv ("SSH_ASKPASS_PROMPT");
+	g_ptr_array_free (argv, TRUE);
+	g_assert_no_error (error);
+
+	g_child_watch_add (pid, on_ssh_child, &status);
+	while (status == -1)
+		g_main_context_iteration (NULL, TRUE);
+
+	count = read (output, buffer, sizeof (buffer) - 1);
+	g_close (output, NULL);
+	g_assert_cmpint (count, >=, 0);
+
+	*exit_status = status;
+	return g_strndup (buffer, count);
+}
+
+static void
+test_message (void)
+{
+	RecordingInteraction *interaction;
+	GcrSshAskpass *askpass;
+	gchar *args[] = { "Enter", "passphrase:", NULL };
+	gchar *output;
+	gint status;
+
+	interaction = g_object_new (recording_interaction_get_type (), NULL);
+	askpass = gcr_ssh_askpass_new (G_TLS_INTERACTION (interaction));
