+static void
+on_prompt_confirm (GObject *source_object,
+                   GAsyncResult *result,
+                   gpointer user_data)
+{
+	GTask *task = G_TASK (user_data);
+	GTlsPassword *password = g_task_get_task_data (task);
+	GcrPrompt *prompt = GCR_PROMPT (source_object);
+	GcrPromptReply reply;
+	GError *error = NULL;
+
+	reply = gcr_prompt_confirm_finish (prompt, result, &error);
+	if (reply == GCR_PROMPT_REPLY_CONTINUE) {
+		/* What OpenSSH's confirm_key() takes as an affirmative answer */
+		g_tls_password_set_value (password, (const guchar *) "yes", 3);
+		g_task_return_int (task, G_TLS_INTERACTION_HANDLED);
+	} else if (error) {
+		g_task_return_error (task, error);
+	} else {
+		g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_CANCELLED, "cancelled");
+	}
+
+	g_object_unref (prompt);
+	g_object_unref (task);
+}
