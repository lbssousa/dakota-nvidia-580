+/**
+ * gcr_ssh_agent_askpass_child_setup:
+ * @askpass: a #GcrSshAskpass object
+ *
+ * Like gcr_ssh_askpass_child_setup(), and additionally makes OpenSSH use
+ * the askpass for everything: the security key PIN, key use confirmation
+ * and the user presence notification. Without SSH_ASKPASS_REQUIRE=force
+ * these depend on DISPLAY/WAYLAND_DISPLAY being set when the child starts.
+ */
+void
+gcr_ssh_agent_askpass_child_setup (gpointer askpass)
+{
+	int saved_stdout;
+	int devnull;
+
+	/* g_setenv() logs a debug message once threads exist, and with
+	 * G_MESSAGES_DEBUG set that goes to stdout. For ssh-agent, stdout is
+	 * the pipe whose first output means "ready to connect", so keep it
+	 * quiet until exec. */
+	saved_stdout = dup (STDOUT_FILENO);
+	devnull = open ("/dev/null", O_WRONLY);
+	if (devnull >= 0) {
+		dup2 (devnull, STDOUT_FILENO);
+		close (devnull);
+	}
+
+	gcr_ssh_askpass_child_setup (askpass);
+	setenv ("SSH_ASKPASS_REQUIRE", "force", 1);
+	unsetenv ("SSH_ASKPASS_PROMPT");
+
+	if (saved_stdout >= 0) {
+		dup2 (saved_stdout, STDOUT_FILENO);
+		close (saved_stdout);
+	}
+}
