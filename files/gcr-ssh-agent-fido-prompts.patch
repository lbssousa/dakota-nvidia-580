+/**
+ * gcr_ssh_agent_process_set_askpass:
+ * @self: a #GcrSshAgentProcess
+ * @askpass: (nullable): the askpass the spawned ssh-agent should use
+ *
+ * ssh-agent itself asks for a security key's PIN, confirms the use of
+ * keys added with `ssh-add -c` and notifies that a security key wants a
+ * touch. Without this, it does so through whatever SSH_ASKPASS happens
+ * to be in the environment, which usually doesn't exist.
+ */
+void
+gcr_ssh_agent_process_set_askpass (GcrSshAgentProcess *self,
+                                   GcrSshAskpass *askpass)
+{
+	g_return_if_fail (GCR_IS_SSH_AGENT_PROCESS (self));
+	g_return_if_fail (askpass == NULL || GCR_IS_SSH_ASKPASS (askpass));
+	g_return_if_fail (self->pid == 0);
+
+	g_set_object (&self->askpass, askpass);
+}
