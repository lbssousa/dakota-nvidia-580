# Units enabled by default on first boot, via systemd's preset mechanism
# (/usr/lib/systemd/system-preset/80-*.preset is applied by
# systemd-preset-all.service at boot, and bootc carries it across
# deployments).
#
# Presets rather than a baked `systemctl enable` symlink tree: this is
# how Bazzite/Bluefin (build_files/nvidia-install.sh, plus
# ublue-nvctk-cdi presets), BlueBuild and projectbluefin/dakota all
# ship their NVIDIA units, and it keeps /usr free of symlinks that
# would have to be regenerated on every `bootc switch`.
#
# This file is preset-file syntax (one enable/disable verb per line),
# not a unit — no [Unit] section, no keys.

# /lib/modules is baked into this image; on a machine with no NVIDIA GPU
# nvidia-modprobe is a no-op and every ExecStart in
# nvidia-device-nodes.service is "-" prefixed, so it succeeds and stays
# out of `systemctl --failed` regardless. Same as the RPM-based images,
# which enable their equivalent unconditionally.
enable nvidia-device-nodes.service

# Suspend/hibernate/resume hooks. These only do anything when
# /proc/driver/nvidia/suspend exists, which requires
# NVreg_PreserveVideoMemoryAllocations=1 — see
# files/nvidia-driver-params.conf, without which these units run but
# GPU context is lost on resume (hard lock) and the driver vetoes
# kernel PM outright (nv_pmops_suspend returns -5, machine can't sleep).
enable nvidia-suspend.service
enable nvidia-resume.service
enable nvidia-hibernate.service
enable nvidia-suspend-then-hibernate.service
