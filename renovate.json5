{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  // Renovate's "dockerfile" manager natively recognizes
  // `FROM image:tag@sha256:digest` lines and opens a PR when the
  // upstream digest changes — the same mechanism dakota-prime uses to
  // track dakota-gaming:stable. CI (build.yml) builds and publishes
  // from that PR; there's no "silent" automatic rebuild without a
  // reviewable PR.
  packageRules: [
    {
      matchManagers: ["dockerfile"],
      matchPackageNames: ["ghcr.io/projectbluefin/dakota"],
      groupName: "dakota base image",
      commitMessagePrefix: "chore(base):",
    },
  ],
}
